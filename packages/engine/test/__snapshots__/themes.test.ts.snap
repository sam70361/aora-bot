exports[`visibility once installed > draws the skins the same every time > doodle 48 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" class="awwmcq5" viewBox="-24 -24 288 288" width="48" height="48" fill="none" aria-hidden="true"><style>
    .awwmcq5 { --awwmcq5-ink: #F1E2C1; --awwmcq5-pc-jc9giz: #FF7228; --awwmcq5-pr-jc9giz: #712F0C; --awwmcq5-fx: #2B2420; }
    @media (prefers-color-scheme: dark) {
      .awwmcq5 { --awwmcq5-ink: #EADBB9; --awwmcq5-pc-jc9giz: #EB6925; --awwmcq5-pr-jc9giz: #682A0A; --awwmcq5-fx: #EADBB9; }
    }
