{
  "name": "@aora-bot/react",
  "version": "0.1.3",
  "description": "React components for the Aora Bot procedural character engine",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://aora-bot.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam70361/aora-bot.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/sam70361/aora-bot/issues",
  "keywords": [
    "react",
    "character",
    "avatar",
    "procedural",
    "svg",
    "animation",
    "mascot",
    "react-server-components"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@aora-bot/engine": "workspace:*"
  },
  "devDependencies": {
    "@rslib/core": "^0.18.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "happy-dom": "^20.14.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
